# Gemini API key for the ADK terminal assistant.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides:
ADK_MODEL=gemini-3-flash-preview
ADK_COMMAND_TIMEOUT_SECONDS=60
ADK_MAX_OUTPUT_CHARS=20000

# To use Vertex AI instead of an API key, set these instead of GOOGLE_API_KEY:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
