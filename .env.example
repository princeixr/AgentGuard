AGENTGUARD_RUNTIME=mock
AGENTGUARD_MAX_STEPS=6
AGENTGUARD_TRACE_DIR=data/traces/raw
AGENTGUARD_USE_MOCK_TOOLS=true
AGENTGUARD_ENABLE_APPROVAL_SIMULATION=false
AGENTGUARD_SCENARIO_DIR=data/scenarios
AGENTGUARD_SEED_MEMORY_DIR=data/seed_memory
OPENCLAW_TRACE_PROFILE=agentguard-traces
OPENCLAW_TRACE_DEFAULT_AGENT=main
OPENCLAW_RAW_ARTIFACT_ROOT=data/openclaw_raw
AGENTGUARD_RAW_TRACE_ROOT=data/traces

# Google ADK terminal-assistant agent (apps/adk_agent).
# Get a Gemini API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
ADK_MODEL=gemini-3-flash-preview
AGENTGUARD_ADK_ENFORCE_APPROVAL=true
# Demo/test override: block every ADK tool call before execution.
AGENTGUARD_FORCE_BLOCK=false
# v1 = V1 enforcement; v2_shadow = V1 enforcement plus V2 evidence;
# v2 = current deterministic V2 policy enforcement.
AGENTGUARD_FIREWALL_MODE=v1
# Tier flags for FirewallV2. Tier 1 defaults on; Tier 2/3 default off.
AGENTGUARD_TIER_1_ENABLED=true
AGENTGUARD_TIER_2_ENABLED=false
AGENTGUARD_TIER_3_ENABLED=false
AGENTGUARD_TIER3_ENFORCEMENT_ENABLED=false
AGENTGUARD_TIER_CONFIDENCE_THRESHOLD=0.75
AGENTGUARD_TIER3_MODEL=gemini-2.5-flash
# Mock pipeline evaluates/logs guard decisions but never executes tools.
AGENTGUARD_MOCK_PIPELINE_ONLY=false
# Optional override for the published JSON policy used by FirewallV2 shadow evaluation.
# AGENTGUARD_POLICY_PATH=policies/personal_assistant_v1.json
AGENTGUARD_ADK_TRACE_NAMESPACE=google_adk
AGENTGUARD_TRACE_ROOT=data/traces
# Leave blank to inherit AGENTGUARD_ELASTIC_ENABLED, or set true/false for ADK only.
AGENTGUARD_ADK_ELASTIC_ENABLED=
AGENTGUARD_ADK_FAIL_ON_ELASTIC_ERROR=false
ADK_GMAIL_MCP_ENABLED=true
GMAIL_MCP_DOCKER_IMAGE=agentguard-gmail-mcp:artymclabin
GMAIL_MCP_CREDENTIALS_VOLUME=mcp-gmail
GMAIL_MCP_TOOL_PREFIX=gmail
# ADK_COMMAND_TIMEOUT_SECONDS=60
# ADK_MAX_OUTPUT_CHARS=20000
# To use Vertex AI instead of an API key, set these instead of GOOGLE_API_KEY:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Elastic storage. Leave disabled for local JSONL-only development.
AGENTGUARD_ELASTIC_ENABLED=false
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=30
AGENTGUARD_ELASTIC_TRACES_INDEX=agentguard-traces-v1
AGENTGUARD_ELASTIC_LIVE_EVENTS_INDEX=agentguard-live-events-v1
AGENTGUARD_ELASTIC_TRACE_FEATURES_INDEX=agentguard-trace-features-v1
AGENTGUARD_ELASTIC_GUARD_SCORES_INDEX=agentguard-guard-scores-v1
AGENTGUARD_ELASTIC_GUARD_DECISIONS_INDEX=agentguard-guard-decisions-v1
AGENTGUARD_ELASTIC_SESSION_RISK_INDEX=agentguard-session-risk-v1
AGENTGUARD_ELASTIC_LABELS_INDEX=agentguard-labels-v1
AGENTGUARD_ELASTIC_SCENARIOS_INDEX=agentguard-scenarios-v1
