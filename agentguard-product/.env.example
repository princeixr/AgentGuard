# AgentGuard server development defaults.

GOOGLE_API_KEY=

AGENTGUARD_FIREWALL_MODE=v2
AGENTGUARD_FORCE_BLOCK=false
AGENTGUARD_TIER_1_ENABLED=true
AGENTGUARD_AGENTTRUST_SHELL_ENABLED=true
AGENTGUARD_INTENT_LLM_ENABLED=true
AGENTGUARD_INTENT_MODEL=gemini-2.5-flash
AGENTGUARD_INTENT_TIMEOUT_SECONDS=8
AGENTGUARD_INTENT_CONFIDENCE_THRESHOLD=0.70
AGENTGUARD_TIER_2_ENABLED=false
AGENTGUARD_TIER_3_ENABLED=true
AGENTGUARD_TIER3_ENFORCEMENT_ENABLED=true
AGENTGUARD_TIER_CONFIDENCE_THRESHOLD=0.75
AGENTGUARD_TIER3_MODEL=gemini-2.5-flash
AGENTGUARD_MOCK_PIPELINE_ONLY=false

AGENTGUARD_APPROVAL_ENFORCED=true
AGENTGUARD_TRACE_NAMESPACE=registered_agents
AGENTGUARD_TRACE_ROOT=data/traces

# Remote transport variables are reserved for Phase 1 implementation.
AGENTGUARD_BASE_URL=http://127.0.0.1:8000
AGENTGUARD_REQUEST_TIMEOUT_SECONDS=2

AGENTGUARD_ELASTIC_ENABLED=false
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=30
