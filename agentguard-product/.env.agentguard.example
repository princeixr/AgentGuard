# AgentGuard server configuration.

AGENTGUARD_SERVER_HOST=127.0.0.1
AGENTGUARD_SERVER_PORT=8000
AGENTGUARD_WEB_ORIGINS=http://127.0.0.1:5173

AGENTGUARD_API_KEY=change-me
AGENTGUARD_ENV=development
AGENTGUARD_REQUIRE_AUTH=true
AGENTGUARD_DOCS_ENABLED=false
AGENTGUARD_API_KEY_PEPPER=change-me-random-pepper
AGENTGUARD_DATABASE_URL=postgresql+psycopg://agentguard:change-me-postgres-password@localhost:5432/agentguard
AGENTGUARD_CACHE_ENABLED=true
AGENTGUARD_REDIS_URL=redis://:change-me-redis-password@localhost:6379/0
AGENTGUARD_RATE_LIMIT_ENABLED=true
AGENTGUARD_RATE_LIMIT_PER_MINUTE=300
AGENTGUARD_IDEMPOTENCY_TTL_SECONDS=900
AGENTGUARD_APPROVAL_CACHE_TTL_SECONDS=3600
AGENTGUARD_REGISTERED_AGENTS_PATH=demo/registered_agents.json
AGENTGUARD_POLICY_PATH=policies/personal_assistant_v1.json

AGENTGUARD_FIREWALL_MODE=v2
AGENTGUARD_FORCE_BLOCK=false
AGENTGUARD_FAIL_CLOSED=true

AGENTGUARD_TIER_1_ENABLED=true
AGENTGUARD_AGENTTRUST_SHELL_ENABLED=true
AGENTGUARD_INTENT_LLM_ENABLED=true
AGENTGUARD_INTENT_MODEL=gemini-2.5-flash
AGENTGUARD_INTENT_TIMEOUT_SECONDS=8
AGENTGUARD_INTENT_CONFIDENCE_THRESHOLD=0.70
AGENTGUARD_TIER_2_ENABLED=false
AGENTGUARD_TIER_3_ENABLED=true
AGENTGUARD_TIER3_ENFORCEMENT_ENABLED=true
AGENTGUARD_TIER_CONFIDENCE_THRESHOLD=0.75
AGENTGUARD_TIER3_MODEL=gemini-2.5-flash

# Required only for LLM-backed intent extraction and Tier 3.
GOOGLE_API_KEY=

AGENTGUARD_TRACE_ROOT=data/traces
AGENTGUARD_ELASTIC_ENABLED=false
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
