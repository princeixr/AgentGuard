{
  "schema_version": "agentguard.policy.v1",
  "policy_id": "pol_personal_assistant",
  "version": "1.0.3",
  "name": "Personal Assistant Safety Policy",
  "description": "Capability guardrails for a laptop-resident personal assistant with terminal, communication, scheduling, workspace, search, and future payment access.",
  "status": "published",
  "scope": {
    "workspace_id": "wsp_agentguard_demo",
    "agent_id": "agt_google_adk_assistant",
    "deployment_id": "dep_google_adk_development"
  },
  "defaults": {
    "unmatched_tool": "block",
    "unknown_action": "require_approval",
    "parser_failure": "allow",
    "semantic_failure": "require_approval",
    "llm_failure": "require_approval",
    "no_rule_match": "require_approval"
  },
  "routing": {
    "read_only": [
      "tier_1"
    ],
    "reversible_side_effect": [
      "tier_1",
      "tier_2"
    ],
    "external_or_irreversible": [
      "tier_1",
      "tier_2",
      "tier_3"
    ],
    "ambiguous": [
      "tier_1",
      "tier_2",
      "tier_3"
    ]
  },
  "rules": [
    {
      "rule_id": "allow_information_retrieval",
      "description": "Allow read-only search and inspection across email, web, calendar, Drive, and filesystem resources.",
      "effect": "allow",
      "severity": "low",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "email.search",
          "email.read",
          "email.list",
          "web.search",
          "calendar.read",
          "calendar.list",
          "calendar.search",
          "drive.read",
          "drive.list",
          "drive.search",
          "filesystem.read",
          "filesystem.inspect"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "allow_reversible_preparation",
      "description": "Allow preparation that does not yet affect an external person or durable resource.",
      "effect": "allow",
      "severity": "low",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "email.draft",
          "calendar.draft",
          "payment.prepare"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "approve_dynamic_shell",
      "description": "Raw shell execution remains ambiguous until the shell normalizer classifies the action.",
      "effect": "allow",
      "severity": "low",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "dynamic.shell"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "approve_external_communication",
      "description": "Sending messages on the user's behalf requires explicit approval.",
      "effect": "require_approval",
      "severity": "high",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "email.send",
          "communication.send"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "approve_workspace_changes",
      "description": "Creating or modifying durable workspace data requires approval.",
      "effect": "require_approval",
      "severity": "medium",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "filesystem.write",
          "drive.write",
          "calendar.create",
          "calendar.update",
          "schedule.create",
          "schedule.update"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "block_destructive_actions",
      "description": "Deletion of files, Drive data, calendar events, or scheduled jobs is blocked by default.",
      "effect": "block",
      "severity": "critical",
      "non_overridable": true,
      "match": {
        "capabilities_any": [
          "filesystem.delete",
          "drive.delete",
          "calendar.delete",
          "schedule.delete"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "block_financial_execution",
      "description": "The personal assistant may prepare but must not execute payments.",
      "effect": "block",
      "severity": "critical",
      "non_overridable": true,
      "match": {
        "capabilities_any": [
          "payment.execute",
          "wallet.transfer"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "block_privilege_and_shell_network",
      "description": "Privilege escalation and shell-originated network access are blocked.",
      "effect": "block",
      "severity": "critical",
      "non_overridable": true,
      "match": {
        "capabilities_any": [
          "system.privilege_escalate",
          "shell.network_request"
        ],
        "tools_any": [],
        "resource_constraints": {}
      }
    },
    {
      "rule_id": "protect_sensitive_paths",
      "description": "Credential, key, wallet, and system configuration paths are protected.",
      "effect": "block",
      "severity": "critical",
      "non_overridable": true,
      "match": {
        "capabilities_any": [],
        "tools_any": [],
        "resource_constraints": {
          "path_any_under": [
            "~/.ssh",
            "~/.aws",
            "~/.config/gcloud",
            "~/Library/Keychains",
            "~/Library/LaunchAgents",
            "/Library/LaunchAgents",
            "/Library/LaunchDaemons",
            "/etc"
          ]
        }
      }
    },
    {
      "rule_id": "approve_untrusted_email_destinations",
      "description": "Recipient-domain restrictions will be evaluated after Gmail normalization.",
      "effect": "require_approval",
      "severity": "high",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "email.send"
        ],
        "tools_any": [],
        "resource_constraints": {
          "recipient_domain_not_in": [
            "gmail.com"
          ]
        }
      }
    },
    {
      "rule_id": "approve_high_value_payment",
      "description": "Payment amount limits will be evaluated after payment normalization.",
      "effect": "block",
      "severity": "critical",
      "non_overridable": false,
      "match": {
        "capabilities_any": [
          "payment.execute"
        ],
        "tools_any": [],
        "resource_constraints": {
          "amount_greater_than": 0
        }
      }
    }
  ],
  "notes": [
    "Structured MCP and function tools are normalized from security metadata and JSON input schemas.",
    "Path, recipient-domain, and amount predicates are evaluated when their argument roles are available.",
    "Shell remains a specialized parser because command behavior is encoded inside shell syntax."
  ]
}
