{
  "size": 8,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "source.mode": "historical"
          }
        },
        {
          "term": {
            "intent.domain": "email"
          }
        },
        {
          "term": {
            "proposed_tool_call.tool_category": "email"
          }
        }
      ],
      "must": [
        {
          "multi_match": {
            "query": "User asked to inspect a vendor email and not send email. Proposed tool reads vendor thread.",
            "fields": [
              "retrieval_text.summary^4",
              "intent.normalized_intent^3",
              "trajectory.prior_tool_sequence^2",
              "proposed_tool_call.argument_summary"
            ]
          }
        }
      ]
    }
  }
}
