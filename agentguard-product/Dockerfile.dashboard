# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_AGENTGUARD_API_KEY=
ENV VITE_AGENTGUARD_API_KEY=$VITE_AGENTGUARD_API_KEY
COPY apps/agentguard_dashboard/package*.json ./
RUN npm ci
COPY apps/agentguard_dashboard ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
