GOOGLE_API_KEY=
ADK_MODEL=gemini-3-flash-preview

AGENT_ID=agt_google_adk_assistant
AGENT_DEPLOYMENT_ID=dep_google_adk_development
AGENT_INTEGRATION_ID=int_google_adk_remote
AGENT_WORKSPACE_ID=wsp_agentguard_demo
AGENT_ENVIRONMENT=development
AGENT_UI_URL=http://127.0.0.1:4173

# Until HTTP transport is implemented, the independent agent uses this explicit fake.
AGENTGUARD_CLIENT_MODE=fake
AGENTGUARD_FAKE_DECISION=allow
AGENTGUARD_ENFORCE_APPROVAL=true

ADK_MCP_CONFIG_PATH=config/adk_mcp_servers.toml
ADK_COMMAND_TIMEOUT_SECONDS=60
ADK_MAX_OUTPUT_CHARS=20000
