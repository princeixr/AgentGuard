# Copy to .env.openclaw and fill in one provider key.
# Do not commit .env.openclaw.

# Recommended for your current setup.
GEMINI_API_KEY=

# Optional alternatives if you use these with OpenClaw.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# OpenClaw profile/state namespace. This is not an agent name.
OPENCLAW_TRACE_PROFILE=agentguard-traces

# Actual OpenClaw agent ids inside the profile.
OPENCLAW_TRACE_DEFAULT_AGENT=agentguard_productivity
OPENCLAW_TRACE_PRODUCTIVITY_AGENT=agentguard_productivity
OPENCLAW_TRACE_MODEL=google/gemini-2.5-pro

# Local paths for trace collection.
OPENCLAW_TRACE_WORKSPACE=.openclaw-traces/workspace
OPENCLAW_TRACE_PRODUCTIVITY_WORKSPACE=.openclaw-traces/productivity_workspace
OPENCLAW_RAW_ARTIFACT_ROOT=data/openclaw_raw
AGENTGUARD_RAW_TRACE_ROOT=data/traces
